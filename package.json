{
  "name": "india-roadmap-instrument",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "validate": "node tools/validate.mjs",
    "validate:incoming": "node tools/validate.mjs --incoming",
    "validate:strict": "node tools/validate.mjs --strict",
    "validate:selftest": "node tools/selftest.mjs",
    "selfcheck": "node tools/stage4-selfcheck.mjs",
    "reachability": "node tools/reachability.mjs",
    "domain-coverage": "node tools/domain-coverage.mjs",
    "url-check": "node tools/url-check.mjs",
    "dev": "next dev",
    "build": "npm run validate && npm run enum-parity && npm run no-bare-root && npm run no-unguarded-prose-field && npm run withdrawn-wording && npm run figure-consistency && npm run manifest && next build && npm run reachability && npm run field-render-audit && npm run domain-coverage",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "audit": "node tools/audit-manifest.mjs",
    "figure-consistency": "node tools/figure-consistency.mjs",
    "regen:lens-fixtures": "node tools/regen-lens-fixtures.mjs",
    "enum-stamp": "node tools/enum-stamp.mjs",
    "no-bare-root": "node tools/no-bare-root.mjs",
    "review-extract": "node tools/gen-review-extract.mjs",
    "commit": "node tools/verify-and-commit.mjs",
    "scan": "node tools/scan-text.mjs",
    "manifest": "node tools/gen-manifest.mjs",
    "no-unguarded-prose-field": "node tools/no-unguarded-prose-field.mjs",
    "field-render-audit": "node tools/field-render-audit.mjs",
    "record-history": "node tools/gen-record-history.mjs",
    "adversarial-pass-input": "node tools/gen-adversarial-pass-input.mjs",
    "pass-input": "node tools/gen-adversarial-pass-input.mjs",
    "regen:render-fixtures": "node tools/regen-render-fixtures.mjs",
    "deploy-check": "node tools/deploy-check.mjs",
    "derivations": "node tools/gen-derivations.mjs",
    "enum-parity": "node tools/enum-parity.mjs --control && node tools/enum-parity.mjs",
    "withdrawn-wording": "node tools/withdrawn-wording.mjs --control && node tools/withdrawn-wording.mjs"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.9.3"
  }
}
