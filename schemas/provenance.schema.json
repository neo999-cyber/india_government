{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provenance.schema.json",
  "title": "Measurement / comparability dispute record",
  "type": "object",
  "required": ["id", "title", "whatChanged", "when", "affectsDomains", "directionOfBias", "bridgeExists", "sources"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^P-\\d{2}$" },
    "title": { "type": "string" },
    "whatChanged": { "type": "string", "minLength": 40 },
    "when": { "type": "string" },
    "affectsDomains": {
      "type": "array", "minItems": 1,
      "items": { "enum": ["macro", "banking", "employment", "poverty", "human-development", "infrastructure", "welfare", "governance", "kashmir", "federalism", "foreign", "defence", "environment", "demography", "all"] }
    },
    "affectsSeries": { "type": "array", "items": { "type": "string" } },
    "directionOfBias": { "enum": ["understates-pre-2014", "overstates-pre-2014", "understates-post-2014", "overstates-post-2014", "disputed", "obscures", "degrades-precision"] },
    "bridgeExists": { "type": "boolean", "description": "Is there any accepted reconciliation across the break?" },
    "bridgeNote": { "type": "string" },
    "competingAccounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["holder", "position"],
        "additionalProperties": false,
        "properties": {
          "holder": { "type": "string" },
          "position": { "type": "string" }
        }
      }
    },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "url", "tier"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "tier": { "enum": ["T1", "T2", "T3", "T4", "T5"] }
        }
      }
    },
    "notes": { "type": "string" }
  }
}
