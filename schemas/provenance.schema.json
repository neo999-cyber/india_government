{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provenance.schema.json",
  "title": "Measurement / comparability dispute record",
  "type": "object",
  "required": [
    "id",
    "title",
    "whatChanged",
    "when",
    "affectsDomains",
    "directionOfBias",
    "bridgeExists",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^P-\\d{2}$"
    },
    "title": {
      "type": "string"
    },
    "whatChanged": {
      "type": "string",
      "minLength": 40
    },
    "when": {
      "type": "string"
    },
    "affectsDomains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "macro",
          "banking",
          "employment",
          "poverty",
          "human-development",
          "infrastructure",
          "welfare",
          "governance",
          "kashmir",
          "federalism",
          "foreign",
          "defence",
          "environment",
          "demography",
          "all"
        ]
      }
    },
    "affectsSeries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Series this record is SPECIFICALLY ABOUT — where the finding concerns that series directly. NOT a list of every series the record bears on. The relationship is deliberately asymmetric: a series may declare many provenanceRefs (P-09 and P-14 are declared by nine series each as general WDI methodology), while a record names only the series its finding concerns. Requiring symmetry would make this field an unmaintainable enumeration. The backlink check therefore runs record-to-series only, and that is correct."
    },
    "directionOfBias": {
      "enum": [
        "understates-pre-2014",
        "overstates-pre-2014",
        "understates-post-2014",
        "overstates-post-2014",
        "disputed",
        "obscures",
        "degrades-precision"
      ]
    },
    "bridgeExists": {
      "type": "boolean",
      "description": "Is there any accepted reconciliation across the break?"
    },
    "bridgeNote": {
      "type": "string"
    },
    "competingAccounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "holder",
          "position"
        ],
        "additionalProperties": false,
        "properties": {
          "holder": {
            "type": "string"
          },
          "position": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "url",
          "tier"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "tier": {
            "enum": [
              "T1",
              "T2",
              "T3",
              "T4",
              "T5"
            ]
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "correctiveSeries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Series that reference this record as the CORRECTIVE rather than the affected party — the honest measure the record points readers toward, or the instrument that measures the wedge it describes. A series listed here carries the ref for navigation, not because it is distorted; directionOfBias does not apply to it. Mirror of affectsSeries: a series must not appear in both."
    }
  }
}