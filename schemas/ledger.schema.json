{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ledger.schema.json",
  "title": "Reform / event / episode record",
  "type": "object",
  "required": ["id", "title", "date", "term", "domains", "type", "summary", "assessment", "sources", "confidence", "asOf"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^L-\\d{4}$" },
    "title": { "type": "string", "minLength": 6 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$", "description": "YYYY-MM or YYYY-MM-DD; use dateEnd for ranges" },
    "dateEnd": { "type": "string", "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$" },
    "term": { "enum": ["baseline", "T1", "T2", "T3"], "description": "baseline = pre-May-2014 (UPA era); T1 = 2014-19; T2 = 2019-24; T3 = 2024-" },
    "domains": {
      "type": "array", "minItems": 1,
      "items": { "enum": ["macro", "banking", "employment", "poverty", "human-development", "infrastructure", "welfare", "governance", "kashmir", "federalism", "foreign", "defence", "environment", "demography"] }
    },
    "type": { "enum": ["reform", "event", "episode", "shock", "institutional"] },
    "summary": { "type": "string", "minLength": 40 },
    "claimAtLaunch": { "type": "string", "description": "What the government said this would achieve, where applicable" },
    "whatHappened": { "type": "string" },
    "assessment": { "enum": ["worked", "partly", "failed", "reversed", "contested", "too-early", "baseline-context"], "description": "baseline-context = pre-2014 record carried for context, not scored" },
    "caseFor": { "type": "string", "description": "Strongest good-faith case in favour" },
    "caseAgainst": { "type": "string", "description": "Strongest good-faith case against" },
    "shockExposure": { "type": "string", "description": "Which external shocks confound assessment of this record, if any" },
    "seriesRefs": { "type": "array", "items": { "type": "string" } },
    "provenanceRefs": { "type": "array", "items": { "type": "string" } },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "url", "tier"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "tier": { "enum": ["T1", "T2", "T3", "T4", "T5"] }
        }
      }
    },
    "confidence": { "enum": ["high", "medium", "low"] },
    "asOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Date this record was last researched/updated" }
  },
  "allOf": [
    {
      "if": { "properties": { "term": { "const": "baseline" } } },
      "then": { "properties": { "assessment": { "const": "baseline-context" } } }
    },
    {
      "if": { "properties": { "assessment": { "enum": ["worked", "partly", "failed", "reversed", "contested"] } } },
      "then": { "required": ["caseFor", "caseAgainst"] }
    }
  ]
}
